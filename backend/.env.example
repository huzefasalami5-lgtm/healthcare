# CuraReach 360 Backend Configuration
APP_NAME="CuraReach 360"
VERSION="1.0.0"
PORT=8000
HOST="0.0.0.0"

# Database Configuration (Supabase PostgreSQL or SQLite)
# For Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# For local SQLite fallback:
DATABASE_URL=sqlite:///./curareach360.db

# Supabase API Configuration
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Security
SECRET_KEY=curareach-360-jwt-secret-key-change-in-production

# Optional Gemini LLM Key for enhanced generative explanations
# If left blank, CuraReach 360 operates in robust live deterministic multi-agent mode
GEMINI_API_KEY=
